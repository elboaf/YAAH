{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "yaah",
  "version": "../package.json",
  "identifier": "com.elboaf.yaah",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "YAAH",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../backend/**/*.py",
      "../backend/whisper/**/*",
      "../backend/bundled_skills/**/*",
      "../backend/bundled_toolkit/**/*"
    ],
    "externalBin": [
      "binaries/backend",
      "binaries/yaah-update-shim"
    ],
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good"
        ]
      }
    }
  }
}
