{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "yaah",
  "version": "0.6.9",
  "identifier": "com.elboaf.yaah",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "YAAH - AI Coding Agent",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../backend/**/*.py", "../backend/whisper/**/*"],
    "externalBin": ["binaries/backend"]
  }
}
